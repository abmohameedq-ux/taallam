PORT=3000
# Required for the separate administrator login; use a long unique secret.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-secret
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# In Railway, set this to the mount path of a persistent Volume
DATA_DIR=

# For production use, configure HTTPS and NODE_ENV=production. Admin and parent sessions are persisted under DATA_DIR. Keep credentials private.

# Accounts, teacher sessions, audit log and curriculum files are stored under DATA_DIR.

# Maximum PDF book upload size in megabytes (default 300; allowed 1-1024)
MAX_PDF_UPLOAD_MB=300

# --- Added in 2.76.0 ---
# Number of reverse-proxy hops in front of the app (Railway = 1; set automatically when RAILWAY_* variables exist).
# Needed so rate limits count each visitor separately instead of sharing the proxy's address.
TRUST_PROXY_HOPS=
# Hard daily cap on AI calls for the whole platform (protects your bill). Default 3000.
AI_DAILY_LIMIT=3000
# Questions per visitor per 15 minutes on the legacy ask endpoint (default 60).
ASK_LIMIT_PER_15MIN=60

# --- Added in 2.77.0: platform cloud voice (backs up phones whose own Arabic voice fails) ---
# Uses the same provider as the AI by default (needs an OpenAI-compatible /audio/speech endpoint).
# Set TTS_ENABLED=0 to switch it off. Audio is cached in memory so repeated slides cost nothing.
TTS_ENABLED=1
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_DAILY_CHARS=400000

# --- Using a Google Gemini key (free tier works for testing) ---
# AI_API_KEY=<your Gemini key>
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=<a current Gemini chat model name from Google AI Studio>
# The voice is detected as Gemini automatically from the URL above (or set TTS_PROVIDER=gemini).
# TTS_MODEL=gemini-2.5-flash-preview-tts   # check the current TTS model name in the Gemini docs
# TTS_VOICE=Kore
