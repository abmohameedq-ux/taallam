PORT=3000
# Required for the separate administrator login; use a long unique secret.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-secret
AI_API_KEY=
# Use gemini for a Google AI Studio API key; otherwise use an OpenAI-compatible provider.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# For OpenAI-compatible providers only:
AI_BASE_URL=https://api.openai.com/v1
# In Railway, set this to the mount path of a persistent Volume
DATA_DIR=

# For production use, configure HTTPS and NODE_ENV=production. Admin and parent sessions are persisted under DATA_DIR. Keep credentials private.

# Accounts, teacher sessions, audit log and curriculum files are stored under DATA_DIR.

# Maximum PDF book upload size in megabytes (default 300; allowed 1-1024)
MAX_PDF_UPLOAD_MB=300

# Vision model used to analyze every PDF page for diagrams, tables and educational figures
AI_VISION_MODEL=gemini-2.5-flash
# Number of pages rendered per batch; does not limit total pages in a book
VISION_PAGE_BATCH_SIZE=10
